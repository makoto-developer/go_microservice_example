      auth-service:
        condition: service_started
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  inventory-service:
    build:
      context: ./generated/inventory-service
      dockerfile: Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_inventory_service_${ENV}
    hostname: ${INVENTORY_SERVICE_HOST}_${ENV}
    env_file:
      - .env
    ports:
      - "${INVENTORY_SERVICE_PORT}:50054"
    environment:
      ENV: ${ENV}
      DB_HOST: postgres_${ENV}
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${INVENTORY_DB_NAME}
      REDIS_HOST: redis_${ENV}
      REDIS_PORT: 6379
      REDIS_PASSWORD: ${REDIS_PASSWORD}
      RABBITMQ_URL: amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq_${ENV}:5672/
      GRPC_PORT: 50054
      SHOP_SERVICE_URL: ${SHOP_SERVICE_HOST}_${ENV}:50052
      LOG_LEVEL: ${LOG_LEVEL}
    networks:
      - microservice_network
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  order-service:
    build:
      context: ./generated/order-service
      dockerfile: Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_order_service_${ENV}
    hostname: ${ORDER_SERVICE_HOST}_${ENV}
    env_file:
      - .env
    ports:
      - "${ORDER_SERVICE_PORT}:50055"
    environment:
      ENV: ${ENV}
      DB_HOST: postgres_${ENV}
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${ORDER_DB_NAME}
      REDIS_HOST: redis_${ENV}
      REDIS_PORT: 6379
      REDIS_PASSWORD: ${REDIS_PASSWORD}
      RABBITMQ_URL: amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq_${ENV}:5672/
      GRPC_PORT: 50055
      CUSTOMER_SERVICE_URL: ${CUSTOMER_SERVICE_HOST}_${ENV}:50053
      INVENTORY_SERVICE_URL: ${INVENTORY_SERVICE_HOST}_${ENV}:50054
      PAYMENT_SERVICE_URL: ${PAYMENT_SERVICE_HOST}_${ENV}:50056
      LOG_LEVEL: ${LOG_LEVEL}
    networks:
      - microservice_network
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  payment-service:
    build:
      context: ./generated/payment-service
      dockerfile: Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_payment_service_${ENV}
    hostname: ${PAYMENT_SERVICE_HOST}_${ENV}
    env_file:
      - .env
    ports:
      - "${PAYMENT_SERVICE_PORT}:50056"
    environment:
      ENV: ${ENV}
      DB_HOST: postgres_${ENV}
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${PAYMENT_DB_NAME}
      REDIS_HOST: redis_${ENV}
      REDIS_PORT: 6379
      REDIS_PASSWORD: ${REDIS_PASSWORD}
      RABBITMQ_URL: amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq_${ENV}:5672/
      GRPC_PORT: 50056
      STRIPE_API_URL: http://mock-stripe_${ENV}:8080
      STRIPE_API_KEY: ${STRIPE_API_KEY}
      STRIPE_WEBHOOK_SECRET: ${STRIPE_WEBHOOK_SECRET}
      LOG_LEVEL: ${LOG_LEVEL}
    networks:
      - microservice_network
    depends_on:
      postgres:
        condition: service_healthy
      mock-stripe:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  shipping-service:
    build:
      context: ./generated/shipping-service
      dockerfile: Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_shipping_service_${ENV}
    hostname: ${SHIPPING_SERVICE_HOST}_${ENV}
    env_file:
      - .env
    ports:
      - "${SHIPPING_SERVICE_PORT}:50057"
    environment:
      ENV: ${ENV}
      DB_HOST: postgres_${ENV}
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${SHIPPING_DB_NAME}
      GRPC_PORT: 50057
      CARRIER_API_URL: http://mock-carriers_${ENV}:8083
      ORDER_SERVICE_URL: ${ORDER_SERVICE_HOST}_${ENV}:50055
      LOG_LEVEL: ${LOG_LEVEL}
    networks:
      - microservice_network
    depends_on:
      postgres:
        condition: service_healthy
      mock-carriers:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  notification-service:
    build:
      context: ./generated/notification-service
      dockerfile: Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_notification_service_${ENV}
    hostname: ${NOTIFICATION_SERVICE_HOST}_${ENV}
    env_file:
      - .env
    ports:
      - "${NOTIFICATION_SERVICE_PORT}:50058"
    environment:
      ENV: ${ENV}
      DB_HOST: postgres_${ENV}
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${NOTIFICATION_DB_NAME}
      RABBITMQ_URL: amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq_${ENV}:5672/
      GRPC_PORT: 50058
      SMTP_HOST: mailhog_${ENV}
      SMTP_PORT: 1025
      SMTP_FROM: noreply@microservice.local
      FCM_API_URL: http://mock-fcm_${ENV}:8082
      FCM_API_KEY: ${FCM_API_KEY}
      FCM_PROJECT_ID: ${FCM_PROJECT_ID}
      LOG_LEVEL: ${LOG_LEVEL}
    networks:
      - microservice_network
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      mailhog:
        condition: service_started
      mock-fcm:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  review-service:
    build:
      context: ./generated/review-service
      dockerfile: Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_review_service_${ENV}
    hostname: ${REVIEW_SERVICE_HOST}_${ENV}
    env_file:
      - .env
    ports:
      - "${REVIEW_SERVICE_PORT}:50059"
    environment:
      ENV: ${ENV}
      DB_HOST: postgres_${ENV}
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${REVIEW_DB_NAME}
      GRPC_PORT: 50059
      CUSTOMER_SERVICE_URL: ${CUSTOMER_SERVICE_HOST}_${ENV}:50053
      SHOP_SERVICE_URL: ${SHOP_SERVICE_HOST}_${ENV}:50052
      LOG_LEVEL: ${LOG_LEVEL}
    networks:
      - microservice_network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  chat-service:
    build:
      context: ./generated/chat-service
      dockerfile: Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_chat_service_${ENV}
    hostname: ${CHAT_SERVICE_HOST}_${ENV}
    env_file:
      - .env
    ports:
      - "${CHAT_SERVICE_GRPC_PORT}:50060"
      - "${CHAT_SERVICE_WS_PORT}:8090"
    environment:
      ENV: ${ENV}
      DB_HOST: postgres_${ENV}
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${CHAT_DB_NAME}
      REDIS_HOST: redis_${ENV}
      REDIS_PORT: 6379
      REDIS_PASSWORD: ${REDIS_PASSWORD}
      GRPC_PORT: 50060
      WS_PORT: 8090
      LOG_LEVEL: ${LOG_LEVEL}
    networks:
      - microservice_network
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  search-service:
    build:
      context: ./generated/search-service
      dockerfile: Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_search_service_${ENV}
    hostname: ${SEARCH_SERVICE_HOST}_${ENV}
    env_file:
      - .env
    ports:
      - "${SEARCH_SERVICE_PORT}:50061"
    environment:
      ENV: ${ENV}
      DB_HOST: postgres_${ENV}
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${SEARCH_DB_NAME}
      RABBITMQ_URL: amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq_${ENV}:5672/
      GRPC_PORT: 50061
      ELASTICSEARCH_URL: http://mock-elasticsearch_${ENV}:9200
      LOG_LEVEL: ${LOG_LEVEL}
    networks:
      - microservice_network
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      mock-elasticsearch:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  admin-service:
    build:
      context: ./generated/admin-service
      dockerfile: Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_admin_service_${ENV}
    hostname: ${ADMIN_SERVICE_HOST}_${ENV}
    env_file:
      - .env
    ports:
      - "${ADMIN_SERVICE_PORT}:50062"
    environment:
      ENV: ${ENV}
      DB_HOST: postgres_${ENV}
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${ADMIN_DB_NAME}
      GRPC_PORT: 50062
      AUTH_SERVICE_URL: ${AUTH_SERVICE_HOST}_${ENV}:50051
      SHOP_SERVICE_URL: ${SHOP_SERVICE_HOST}_${ENV}:50052
      ORDER_SERVICE_URL: ${ORDER_SERVICE_HOST}_${ENV}:50055
      CUSTOMER_SERVICE_URL: ${CUSTOMER_SERVICE_HOST}_${ENV}:50053
      LOG_LEVEL: ${LOG_LEVEL}
    networks:
      - microservice_network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  postgres_data:
    name: ${COMPOSE_PROJECT_NAME}_postgres_data_${ENV}
    driver: local
  redis_data:
    name: ${COMPOSE_PROJECT_NAME}_redis_data_${ENV}
    driver: local
  rabbitmq_data:
    name: ${COMPOSE_PROJECT_NAME}_rabbitmq_data_${ENV}
    driver: local
  rabbitmq_log:
    name: ${COMPOSE_PROJECT_NAME}_rabbitmq_log_${ENV}
    driver: local

networks:
  microservice_network:
    name: ${COMPOSE_PROJECT_NAME}_network_${ENV}
    driver: bridge
