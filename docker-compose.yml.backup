version: '3.9'

services:
  # ========================================
  # Infrastructure Services
  # ========================================

  postgres:
    image: postgres:17-alpine
    container_name: ${COMPOSE_PROJECT_NAME}_postgres_${ENV}
    hostname: postgres_${ENV}
    env_file:
      - .env
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
      PGDATA: /var/lib/postgresql/data/pgdata
    ports:
      - "${POSTGRES_PORT}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./scripts/init-db.sql:/docker-entrypoint-initdb.d/init.sql
    networks:
      - microservice_network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 2G
        reservations:
          cpus: '0.5'
          memory: 512M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  redis:
    image: redis:7.4-alpine
    container_name: ${COMPOSE_PROJECT_NAME}_redis_${ENV}
    hostname: redis_${ENV}
    env_file:
      - .env
    command: redis-server --appendonly yes --requirepass ${REDIS_PASSWORD}
    ports:
      - "${REDIS_PORT}:6379"
    volumes:
      - redis_data:/data
    networks:
      - microservice_network
    healthcheck:
      test: ["CMD", "redis-cli", "--raw", "incr", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 5s
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  rabbitmq:
    image: rabbitmq:4-management-alpine
    container_name: ${COMPOSE_PROJECT_NAME}_rabbitmq_${ENV}
    hostname: rabbitmq_${ENV}
    env_file:
      - .env
    environment:
      RABBITMQ_DEFAULT_USER: ${RABBITMQ_USER}
      RABBITMQ_DEFAULT_PASS: ${RABBITMQ_PASSWORD}
      RABBITMQ_DEFAULT_VHOST: /
    ports:
      - "${RABBITMQ_PORT}:5672"
      - "${RABBITMQ_MANAGEMENT_PORT}:15672"
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
      - rabbitmq_log:/var/log/rabbitmq
    networks:
      - microservice_network
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 1G
        reservations:
          cpus: '0.25'
          memory: 256M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ========================================
  # MailHog - Email Testing Tool
  # ========================================

  mailhog:
    image: mailhog/mailhog:latest
    container_name: ${COMPOSE_PROJECT_NAME}_mailhog_${ENV}
    hostname: mailhog_${ENV}
    env_file:
      - .env
    ports:
      - "${MAILHOG_SMTP_PORT}:1025"  # SMTP port
      - "${MAILHOG_UI_PORT}:8025"    # Web UI
    networks:
      - microservice_network
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          cpus: '0.1'
          memory: 64M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ========================================
  # Mock External Services
  # ========================================

  mock-stripe:
    build:
      context: .
      dockerfile: mock/stripe/Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_mock_stripe_${ENV}
    hostname: mock-stripe_${ENV}
    env_file:
      - .env
    ports:
      - "${MOCK_STRIPE_PORT}:8080"
    environment:
      PORT: 8080
    networks:
      - microservice_network
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8080/health"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 5s
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          cpus: '0.1'
          memory: 64M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  mock-fcm:
    build:
      context: .
      dockerfile: mock/fcm/Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_mock_fcm_${ENV}
    hostname: mock-fcm_${ENV}
    env_file:
      - .env
    ports:
      - "${MOCK_FCM_PORT}:8082"
    environment:
      PORT: 8082
    networks:
      - microservice_network
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8082/health"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 5s
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          cpus: '0.1'
          memory: 64M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  mock-elasticsearch:
    build:
      context: .
      dockerfile: mock/elasticsearch/Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_mock_elasticsearch_${ENV}
    hostname: mock-elasticsearch_${ENV}
    env_file:
      - .env
    ports:
      - "${MOCK_ELASTICSEARCH_PORT}:9200"
    environment:
      PORT: 9200
    networks:
      - microservice_network
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:9200/health"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 5s
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          cpus: '0.1'
          memory: 64M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  mock-carriers:
    build:
      context: .
      dockerfile: mock/carriers/Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_mock_carriers_${ENV}
    hostname: mock-carriers_${ENV}
    env_file:
      - .env
    ports:
      - "${MOCK_CARRIERS_PORT}:8083"
    environment:
      PORT: 8083
    networks:
      - microservice_network
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8083/health"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 5s
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          cpus: '0.1'
          memory: 64M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ========================================
  # Microservices
  # ========================================

  auth-service:
    build:
      context: .
      dockerfile: ./generated/auth-service/Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_auth_service_${ENV}
    hostname: ${AUTH_SERVICE_HOST}_${ENV}
    env_file:
      - .env
    ports:
      - "${AUTH_SERVICE_PORT}:50051"
    environment:
      ENV: ${ENV}
      DB_HOST: postgres_${ENV}
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${AUTH_DB_NAME}
      REDIS_HOST: redis_${ENV}
      REDIS_PORT: 6379
      REDIS_PASSWORD: ${REDIS_PASSWORD}
      GRPC_PORT: 50051
      JWT_SECRET: ${JWT_SECRET}
      JWT_EXPIRY: ${JWT_EXPIRY}
      LOG_LEVEL: ${LOG_LEVEL}
    networks:
      - microservice_network
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  shop-service:
    build:
      context: ./generated/shop-service
      dockerfile: Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_shop_service_${ENV}
    hostname: ${SHOP_SERVICE_HOST}_${ENV}
    env_file:
      - .env
    ports:
      - "${SHOP_SERVICE_PORT}:50052"
    environment:
      ENV: ${ENV}
      DB_HOST: postgres_${ENV}
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${SHOP_DB_NAME}
      REDIS_HOST: redis_${ENV}
      REDIS_PORT: 6379
      REDIS_PASSWORD: ${REDIS_PASSWORD}
      GRPC_PORT: 50052
      AUTH_SERVICE_URL: ${AUTH_SERVICE_HOST}_${ENV}:50051
      LOG_LEVEL: ${LOG_LEVEL}
    networks:
      - microservice_network
    depends_on:
      postgres:
        condition: service_healthy
      auth-service:
        condition: service_started
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  customer-service:
    build:
      context: ./generated/customer-service
      dockerfile: Dockerfile
    container_name: ${COMPOSE_PROJECT_NAME}_customer_service_${ENV}
    hostname: ${CUSTOMER_SERVICE_HOST}_${ENV}
    env_file:
      - .env
    ports:
      - "${CUSTOMER_SERVICE_PORT}:50053"
    environment:
      ENV: ${ENV}
      DB_HOST: postgres_${ENV}
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${CUSTOMER_DB_NAME}
      REDIS_HOST: redis_${ENV}
      REDIS_PORT: 6379
      REDIS_PASSWORD: ${REDIS_PASSWORD}
      GRPC_PORT: 50053
      AUTH_SERVICE_URL: ${AUTH_SERVICE_HOST}_${ENV}:50051
      LOG_LEVEL: ${LOG_LEVEL}
    networks:
      - microservice_network
    depends_on:
