// Shipping Service DSL Definition
// Based on: docs/requirements/07_shipping_service.md

microservice ShippingService {
  version: "v1"

  // =========================================
  // Entities (Domain Models)
  // =========================================

  entity ShippingMethod {
    id: UUID primary_key
    shop_id: UUID not_null
    name: string not_null
    carrier: Carrier not_null
    base_fee: decimal not_null
    weight_limit_kg: decimal nullable
    size_limit_cm: int nullable
    is_active: boolean default(true)
    created_at: timestamp not_null
    updated_at: timestamp not_null
  }

  entity ShippingRate {
    id: UUID primary_key
    shipping_method_id: UUID foreign_key(ShippingMethod.id) not_null
    prefecture: string not_null
    base_rate: decimal not_null
    weight_rate_per_kg: decimal default(0)
    size_rate_per_cm: decimal default(0)
    created_at: timestamp not_null
  }

  entity Shipment {
    id: UUID primary_key
    order_id: UUID unique not_null
    tracking_number: string nullable
    carrier: Carrier not_null
    status: ShipmentStatus not_null default(PREPARING)
    shipping_address: string not_null
    recipient_name: string not_null
    recipient_phone: string not_null
    delivery_date: date nullable
    delivery_time_slot: TimeSlot nullable
    delivery_option: DeliveryOption nullable
    shipping_fee: decimal not_null
    dispatched_at: timestamp nullable
    delivered_at: timestamp nullable
    created_at: timestamp not_null
    updated_at: timestamp not_null
  }

  entity ShipmentHistory {
    id: UUID primary_key
    shipment_id: UUID foreign_key(Shipment.id) not_null
    old_status: ShipmentStatus nullable
    new_status: ShipmentStatus not_null
    location: string nullable
    description: text nullable
    updated_by: string not_null
    created_at: timestamp not_null
  }

  entity CarrierTracking {
    id: UUID primary_key
    shipment_id: UUID foreign_key(Shipment.id) not_null
    tracking_number: string not_null
    carrier: Carrier not_null
    last_updated_at: timestamp not_null
    tracking_data: json not_null
    created_at: timestamp not_null
    updated_at: timestamp not_null
  }

  // =========================================
  // Enums
  // =========================================

  enum Carrier {
    YAMATO,
    SAGAWA,
    JAPAN_POST,
    CLICKPOST,
    NEKOPOS
  }

  enum ShipmentStatus {
    PREPARING,
    AWAITING_PICKUP,
    IN_TRANSIT,
    AT_DISTRIBUTION_CENTER,
    OUT_FOR_DELIVERY,
    DELIVERED,
    DELIVERY_ATTEMPTED,
    DELIVERY_FAILED
  }

  enum TimeSlot {
    MORNING,
    NOON_TO_2PM,
    PM_2_TO_4,
    PM_4_TO_6,
    PM_6_TO_8,
    PM_7_TO_9
  }

  enum DeliveryOption {
    STANDARD,
    FRONT_DOOR,
    DELIVERY_BOX,
    GAS_METER_BOX,
    GIFT_WRAPPING
  }

  // =========================================
  // Use Cases
  // =========================================

  // Shipping Rate Calculation
  usecase CalculateShippingFee {
    input: {
      shop_id: UUID
      prefecture: string
      total_weight_kg: decimal
      total_size_cm: int
      subtotal: decimal
    }
    output: {
      shipping_fee: decimal
      free_shipping: boolean
      eligible_methods: list<ShippingMethodOption>
    }
    errors: {
      ShopNotFound,
      UnsupportedArea,
      ExceedsWeightLimit,
      ExceedsSizeLimit
    }
  }

  // Shipment Management
  usecase CreateShipment {
    input: {
      order_id: UUID
      shipping_method_id: UUID
      shipping_address: string
      recipient_name: string
      recipient_phone: string
      delivery_date: date
      delivery_time_slot: TimeSlot
      delivery_option: DeliveryOption
    }
    output: {
      shipment_id: UUID
      shipping_fee: decimal
    }
    errors: {
      OrderNotFound,
      ShippingMethodNotFound,
      InvalidDeliveryDate
    }
  }

  usecase RegisterTrackingNumber {
    input: {
      shipment_id: UUID
      tracking_number: string
      carrier: Carrier
    }
    output: {
      shipment_id: UUID
      tracking_url: string
    }
    errors: {
      ShipmentNotFound,
      InvalidTrackingNumber
    }
    validation: {
      tracking_number: carrier_format_validation
    }
  }

  usecase UpdateShipmentStatus {
    input: {
      shipment_id: UUID
      new_status: ShipmentStatus
      location: string
      description: string
      updated_by: string
    }
    output: {
      shipment_id: UUID
      old_status: ShipmentStatus
      new_status: ShipmentStatus
    }
    errors: {
      ShipmentNotFound,
      InvalidStatusTransition
    }
    events: {
      publish ShipmentStatusUpdated
    }
  }

  usecase GetShipmentDetail {
    input: {
      shipment_id: UUID
    }
    output: {
      shipment: Shipment
      history: list<ShipmentHistory>
      tracking_url: string
    }
    errors: {
      ShipmentNotFound
    }
  }

  usecase GetShipmentByOrder {
    input: {
      order_id: UUID
    }
    output: {
      shipment: Shipment
      history: list<ShipmentHistory>
    }
    errors: {
      ShipmentNotFound
    }
  }

  // Carrier Integration
  usecase SyncCarrierTracking {
    input: {
      shipment_id: UUID
    }
    output: {
      status: ShipmentStatus
      latest_location: string
      updated: boolean
    }
    errors: {
      ShipmentNotFound,
      TrackingNumberNotRegistered,
      CarrierAPIError
    }
    external_api: {
      yamato: YamatoTrackingAPI
      sagawa: SagawaTrackingAPI
      japan_post: JapanPostTrackingAPI
    }
  }

  usecase BatchSyncAllShipments {
    input: {}
    output: {
      total_synced: int
      total_updated: int
      errors: list<string>
    }
    errors: {}
    scheduled: "0 * * * *"  // Every hour
  }

  // Address Validation
  usecase ValidateAddress {
    input: {
      postal_code: string
      prefecture: string
      city: string
      address_line: string
    }
    output: {
      is_valid: boolean
      normalized_address: string
      deliverable: boolean
      warnings: list<string>
    }
    errors: {
      InvalidPostalCode
    }
  }

  usecase NormalizeAddress {
    input: {
      postal_code: string
      prefecture: string
      city: string
      address_line: string
      building: string
    }
    output: {
      normalized_postal_code: string
      normalized_prefecture: string
      normalized_city: string
      normalized_address_line: string
      normalized_building: string
    }
    errors: {}
  }

  // =========================================
  // gRPC Service Definition
  // =========================================

  grpc_service {
    // Shipping Rate
    rpc CalculateShippingFee(CalculateShippingFeeRequest) returns (CalculateShippingFeeResponse)

    // Shipment Management
    rpc CreateShipment(CreateShipmentRequest) returns (CreateShipmentResponse)
    rpc RegisterTrackingNumber(RegisterTrackingNumberRequest) returns (RegisterTrackingNumberResponse)
    rpc UpdateShipmentStatus(UpdateShipmentStatusRequest) returns (UpdateShipmentStatusResponse)
    rpc GetShipmentDetail(GetShipmentDetailRequest) returns (GetShipmentDetailResponse)
    rpc GetShipmentByOrder(GetShipmentByOrderRequest) returns (GetShipmentByOrderResponse)

    // Carrier Tracking
    rpc SyncCarrierTracking(SyncCarrierTrackingRequest) returns (SyncCarrierTrackingResponse)

    // Address Validation
    rpc ValidateAddress(ValidateAddressRequest) returns (ValidateAddressResponse)
    rpc NormalizeAddress(NormalizeAddressRequest) returns (NormalizeAddressResponse)
  }

  // =========================================
  // Dependencies
  // =========================================

  dependencies {
    database: PostgreSQL
    cache: Redis
    messaging: RabbitMQ
    external_api: {
      yamato: YamatoTrackingAPI
      sagawa: SagawaTrackingAPI
      japan_post: JapanPostTrackingAPI
    }
  }

  // =========================================
  // Events
  // =========================================

  events {
    publish ShipmentStatusUpdated {
      shipment_id: UUID
      order_id: UUID
      old_status: ShipmentStatus
      new_status: ShipmentStatus
      tracking_number: string
      updated_at: timestamp
    }

    publish ShipmentDispatched {
      shipment_id: UUID
      order_id: UUID
      tracking_number: string
      carrier: Carrier
      dispatched_at: timestamp
    }

    publish ShipmentDelivered {
      shipment_id: UUID
      order_id: UUID
      delivered_at: timestamp
    }

    subscribe OrderConfirmed {
      order_id: UUID
      shipping_address: string
      recipient_name: string
      recipient_phone: string
    }
  }

  // =========================================
  // Configuration
  // =========================================

  config {
    free_shipping_threshold: 5000
    tracking_sync_interval_hours: 1
    carrier_api_timeout_seconds: 30
    default_time_slots: ["MORNING", "PM_2_TO_4", "PM_4_TO_6", "PM_6_TO_8"]
    yamato_api_key: env("YAMATO_API_KEY")
    sagawa_api_key: env("SAGAWA_API_KEY")
    japan_post_api_key: env("JAPAN_POST_API_KEY")
  }

  // =========================================
  // Custom Logic Required
  // =========================================

  custom_implementations {
    // manual/shipping/carrier_clients.go
    yamato_tracking_api_client
    sagawa_tracking_api_client
    japan_post_tracking_api_client

    // manual/shipping/address_normalizer.go
    address_normalization_logic
  }
}
