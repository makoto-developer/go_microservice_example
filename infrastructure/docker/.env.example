# ========================================
# プロジェクト設定
# ========================================
COMPOSE_PROJECT_NAME=go_microservice
ENV=dev

# ========================================
# 基本インフラ (22000-22009)
# ========================================
# Elasticsearch
ELASTICSEARCH_PORT=22000
ELASTICSEARCH_TRANSPORT_PORT=22001

# RabbitMQ
RABBITMQ_PORT=22002
RABBITMQ_MANAGEMENT_PORT=22003
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=rabbitmq_password

# MinIO
MINIO_PORT=22004
MINIO_CONSOLE_PORT=22005
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio_password

# MailHog
MAILHOG_SMTP_PORT=22006
MAILHOG_UI_PORT=22007

# ========================================
# PostgreSQL (22010-22021)
# ========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

POSTGRES_AUTH_PORT=22010
POSTGRES_SHOP_PORT=22011
POSTGRES_CUSTOMER_PORT=22012
POSTGRES_INVENTORY_PORT=22013
POSTGRES_ORDER_PORT=22014
POSTGRES_PAYMENT_PORT=22015
POSTGRES_SHIPPING_PORT=22016
POSTGRES_NOTIFICATION_PORT=22017
POSTGRES_REVIEW_PORT=22018
POSTGRES_CHAT_PORT=22019
POSTGRES_SEARCH_PORT=22020
POSTGRES_ADMIN_PORT=22021

# ========================================
# Redis (22030-22041)
# ========================================
REDIS_PASSWORD=redis_password

REDIS_AUTH_PORT=22030
REDIS_SHOP_PORT=22031
REDIS_CUSTOMER_PORT=22032
REDIS_INVENTORY_PORT=22033
REDIS_ORDER_PORT=22034
REDIS_PAYMENT_PORT=22035
REDIS_SHIPPING_PORT=22036
REDIS_NOTIFICATION_PORT=22037
REDIS_REVIEW_PORT=22038
REDIS_CHAT_PORT=22039
REDIS_SEARCH_PORT=22040
REDIS_ADMIN_PORT=22041
