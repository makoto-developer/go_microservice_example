# ========================================
# Environment Configuration
# ========================================
# Copy this file to .env and configure for your environment
# Example: cp .env.example .env

# Environment (dev, test, staging, prod)
ENV=dev

# Project Configuration
COMPOSE_PROJECT_NAME=go_microservice

# ========================================
# Infrastructure Services
# ========================================

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=microservice
POSTGRES_PORT=20000

# Redis
REDIS_PORT=20001
REDIS_PASSWORD=change_me_in_production

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_PORT=20002
RABBITMQ_MANAGEMENT_PORT=20003

# MailHog (Email Testing - SMTP Mock Server)
MAILHOG_SMTP_PORT=20004
MAILHOG_UI_PORT=20005

# ========================================
# Mock Services Configuration
# ========================================

MOCK_STRIPE_PORT=20010
MOCK_SENDGRID_PORT=20011
MOCK_FCM_PORT=20012
MOCK_ELASTICSEARCH_PORT=20013
MOCK_CARRIERS_PORT=20014

# ========================================
# Microservices Configuration
# ========================================

# Port Range: 20100-20112
AUTH_SERVICE_PORT=20100
SHOP_SERVICE_PORT=20101
CUSTOMER_SERVICE_PORT=20102
INVENTORY_SERVICE_PORT=20103
ORDER_SERVICE_PORT=20104
PAYMENT_SERVICE_PORT=20105
SHIPPING_SERVICE_PORT=20106
NOTIFICATION_SERVICE_PORT=20107
REVIEW_SERVICE_PORT=20108
CHAT_SERVICE_GRPC_PORT=20109
CHAT_SERVICE_WS_PORT=20110
SEARCH_SERVICE_PORT=20111
ADMIN_SERVICE_PORT=20112

# ========================================
# Database Configuration per Service
# ========================================

AUTH_DB_NAME=auth_db
SHOP_DB_NAME=shop_db
CUSTOMER_DB_NAME=customer_db
INVENTORY_DB_NAME=inventory_db
ORDER_DB_NAME=order_db
PAYMENT_DB_NAME=payment_db
SHIPPING_DB_NAME=shipping_db
NOTIFICATION_DB_NAME=notification_db
REVIEW_DB_NAME=review_db
CHAT_DB_NAME=chat_db
SEARCH_DB_NAME=search_db
ADMIN_DB_NAME=admin_db

# ========================================
# External Service API Keys (Mock in dev)
# ========================================

# Stripe
STRIPE_API_KEY=mock_stripe_key_dev
STRIPE_WEBHOOK_SECRET=mock_webhook_secret_dev

# SendGrid
SENDGRID_API_KEY=mock_sendgrid_key_dev

# Firebase Cloud Messaging (FCM)
FCM_API_KEY=mock_fcm_key_dev
FCM_PROJECT_ID=mock-project

# ========================================
# Service URLs (Internal Docker Network)
# ========================================

# Internal container ports (used for inter-service communication)
INTERNAL_GRPC_PORT_BASE=50051

# Service hostnames
AUTH_SERVICE_HOST=auth-service
SHOP_SERVICE_HOST=shop-service
CUSTOMER_SERVICE_HOST=customer-service
INVENTORY_SERVICE_HOST=inventory-service
ORDER_SERVICE_HOST=order-service
PAYMENT_SERVICE_HOST=payment-service
SHIPPING_SERVICE_HOST=shipping-service
NOTIFICATION_SERVICE_HOST=notification-service
REVIEW_SERVICE_HOST=review-service
CHAT_SERVICE_HOST=chat-service
SEARCH_SERVICE_HOST=search-service
ADMIN_SERVICE_HOST=admin-service

# ========================================
# Logging & Monitoring
# ========================================

LOG_LEVEL=info
LOG_FORMAT=json

# ========================================
# Security
# ========================================

# JWT Secret (CHANGE IN PRODUCTION!)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=3600

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ========================================
# Development Options
# ========================================

# Enable debug mode
DEBUG=false

# Enable hot reload
HOT_RELOAD=false
