# ========================================
# Environment Configuration
# ========================================
ENV=dev
COMPOSE_PROJECT_NAME=go_microservice

# ========================================
# Infrastructure Services
# ========================================

# Elasticsearch
ELASTICSEARCH_PORT=9200

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MailHog (Email Testing)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ========================================
# PostgreSQL Configuration (per service)
# ========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# PostgreSQL Ports (5432-5443)
POSTGRES_AUTH_PORT=5432
POSTGRES_SHOP_PORT=5433
POSTGRES_CUSTOMER_PORT=5434
POSTGRES_INVENTORY_PORT=5435
POSTGRES_ORDER_PORT=5436
POSTGRES_PAYMENT_PORT=5437
POSTGRES_SHIPPING_PORT=5438
POSTGRES_NOTIFICATION_PORT=5439
POSTGRES_REVIEW_PORT=5440
POSTGRES_CHAT_PORT=5441
POSTGRES_SEARCH_PORT=5442
POSTGRES_ADMIN_PORT=5443

# ========================================
# Redis Configuration (per service)
# ========================================
REDIS_PASSWORD=redis_password

# Redis Ports (6379-6390)
REDIS_AUTH_PORT=6379
REDIS_SHOP_PORT=6380
REDIS_CUSTOMER_PORT=6381
REDIS_INVENTORY_PORT=6382
REDIS_ORDER_PORT=6383
REDIS_PAYMENT_PORT=6384
REDIS_SHIPPING_PORT=6385
REDIS_NOTIFICATION_PORT=6386
REDIS_REVIEW_PORT=6387
REDIS_CHAT_PORT=6388
REDIS_SEARCH_PORT=6389
REDIS_ADMIN_PORT=6390

# ========================================
# Microservices Configuration
# ========================================

# gRPC Ports (50051-50062)
AUTH_SERVICE_PORT=50051
SHOP_SERVICE_PORT=50052
CUSTOMER_SERVICE_PORT=50053
INVENTORY_SERVICE_PORT=50054
ORDER_SERVICE_PORT=50055
PAYMENT_SERVICE_PORT=50056
SHIPPING_SERVICE_PORT=50057
NOTIFICATION_SERVICE_PORT=50058
REVIEW_SERVICE_PORT=50059
CHAT_SERVICE_GRPC_PORT=50060
CHAT_SERVICE_WS_PORT=8090
SEARCH_SERVICE_PORT=50061
ADMIN_SERVICE_PORT=50062

# Service hostnames
AUTH_SERVICE_HOST=auth-service
SHOP_SERVICE_HOST=shop-service
CUSTOMER_SERVICE_HOST=customer-service
INVENTORY_SERVICE_HOST=inventory-service
ORDER_SERVICE_HOST=order-service
PAYMENT_SERVICE_HOST=payment-service
SHIPPING_SERVICE_HOST=shipping-service
NOTIFICATION_SERVICE_HOST=notification-service
REVIEW_SERVICE_HOST=review-service
CHAT_SERVICE_HOST=chat-service
SEARCH_SERVICE_HOST=search-service
ADMIN_SERVICE_HOST=admin-service

# ========================================
# Database Names
# ========================================
AUTH_DB_NAME=auth_service
SHOP_DB_NAME=shop_service
CUSTOMER_DB_NAME=customer_service
INVENTORY_DB_NAME=inventory_service
ORDER_DB_NAME=order_service
PAYMENT_DB_NAME=payment_service
SHIPPING_DB_NAME=shipping_service
NOTIFICATION_DB_NAME=notification_service
REVIEW_DB_NAME=review_service
CHAT_DB_NAME=chat_service
SEARCH_DB_NAME=search_service
ADMIN_DB_NAME=admin_service

# ========================================
# External Service API Keys (Mock in dev)
# ========================================

# Stripe
STRIPE_API_KEY=mock_stripe_key_dev
STRIPE_WEBHOOK_SECRET=mock_webhook_secret_dev

# SendGrid
SENDGRID_API_KEY=mock_sendgrid_key_dev

# Firebase Cloud Messaging (FCM)
FCM_API_KEY=mock_fcm_key_dev
FCM_PROJECT_ID=mock-project

# ========================================
# Logging & Monitoring
# ========================================
LOG_LEVEL=info
LOG_FORMAT=json

# ========================================
# Security
# ========================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=3600

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ========================================
# Development Options
# ========================================
DEBUG=false
HOT_RELOAD=false

# Auth Service
AUTH_SERVER_PORT=50051
AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_db?sslmode=disable
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
